<Project>
  <PropertyGroup>
    <Authors>Microsoft</Authors>
    <Copyright>© Microsoft Corporation. All rights reserved.</Copyright>
    <LangVersion>latest</LangVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://dot.net</PackageProjectUrl>
    <PackageReleaseNotes>https://go.microsoft.com/fwlink/?LinkID=799421</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/dotnet/runtime/tree/main/src/tools/ilasm</RepositoryUrl>
    <VersionPrefix>11.0.0</VersionPrefix>
    <Description>The .NET IL Assembler.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName) == 'ILAssembler'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup>
    <TargetRid Condition="$(TargetRid) == ''">$(NETCoreSdkRuntimeIdentifier)</TargetRid>
    <IsInBuildToolProject Condition="$(MSBuildProjectName.EndsWith('_inbuild'))">true</IsInBuildToolProject>
  </PropertyGroup>

  <PropertyGroup>
    <NetCoreAppToolCurrentVersion>11.0</NetCoreAppToolCurrentVersion>
    <NetCoreAppToolCurrent>net$(NetCoreAppToolCurrentVersion)</NetCoreAppToolCurrent>
    <NetCoreAppMinimum>net10.0</NetCoreAppMinimum>
    <NetFrameworkToolCurrent>net4.7.2</NetFrameworkToolCurrent>
  </PropertyGroup>

  <PropertyGroup>
    <CoreClrProjectRoot>$(MSBuildThisFileDirectory)</CoreClrProjectRoot>
    <CoreclrRuntimeBinDir>$(MSBuildThisFileDirectory)bin\</CoreclrRuntimeBinDir>
    <RepositoryEngineeringDir>$(MSBuildThisFileDirectory)eng\</RepositoryEngineeringDir>
    <LibrariesProjectRoot>$(MSBuildThisFileDirectory)\libraries\</LibrariesProjectRoot>
    <CoreLibSharedDir>$(LibrariesProjectRoot)\System.Private.CoreLib\src\</CoreLibSharedDir>
  </PropertyGroup>

  <PropertyGroup>
    <!-- File version numbers -->
    <PackageVersionNet10>10.0.15</PackageVersionNet10>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Maintenance-Packages dependencies -->
    <MicrosoftBclHashCodeVersion>6.0.0</MicrosoftBclHashCodeVersion>
    <SystemMemoryVersion>4.6.3</SystemMemoryVersion>
    <SystemRuntimeCompilerServicesUnsafeVersion>6.1.2</SystemRuntimeCompilerServicesUnsafeVersion>
  </PropertyGroup>

  <PropertyGroup>
    <MicrosoftDotNetXUnitExtensionsPackageVersion>12.0.0-*</MicrosoftDotNetXUnitExtensionsPackageVersion>
    <SystemCommandLinePackageVersion>3.0.0</SystemCommandLinePackageVersion>
  </PropertyGroup>

  <PropertyGroup>
    <MicrosoftDotNetXUnitExtensionsVersion>$(MicrosoftDotNetXUnitExtensionsPackageVersion)</MicrosoftDotNetXUnitExtensionsVersion>
    <SystemCommandLineVersion>$(SystemCommandLinePackageVersion)</SystemCommandLineVersion>
    <Antlr4BuildTasksVersion>12.14.0</Antlr4BuildTasksVersion>
    <Antlr4RuntimeStandardVersion>4.13.1</Antlr4RuntimeStandardVersion>
    <MicrosoftNETTestSdkVersion>18.12.0</MicrosoftNETTestSdkVersion>
    <CoverletCollectorVersion>10.1.1</CoverletCollectorVersion>
  </PropertyGroup>

  <PropertyGroup>
    <XUnitVersion>2.9.3</XUnitVersion>
    <XUnitAnalyzersVersion>2.3.0</XUnitAnalyzersVersion>
    <XUnitRunnerVisualStudioVersion>4.0.1</XUnitRunnerVisualStudioVersion>
  </PropertyGroup>
</Project>
